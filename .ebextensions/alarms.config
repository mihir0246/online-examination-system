Resources:
  AWSEBCloudWatchAlarmHighCPU:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: ExamSystem-HighCPU
      AlarmDescription: "CPU utilization > 80% for 5 minutes"
      MetricName: CPUUtilization
      Namespace: AWS/EC2
      Statistic: Average
      Period: 300
      EvaluationPeriods: 1
      Threshold: 80
      ComparisonOperator: GreaterThanThreshold
      Dimensions:
        - Name: InstanceId
          Value: { "Ref": "AWSEBAutoScalingGroup" }
      AlarmActions:
        # Uncomment and replace with your SNS Topic ARN to enable notifications:
        # - arn:aws:sns:ap-south-1:YOUR_ACCOUNT_ID:exam-system-alerts

  AWSEBCloudWatchAlarmLatency:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: ExamSystem-HighLatency
      AlarmDescription: "p95 latency > 500ms for 5 minutes"
      MetricName: TargetResponseTime
      Namespace: AWS/ApplicationELB
      ExtendedStatistic: p95
      Period: 300
      EvaluationPeriods: 1
      Threshold: 0.500
      ComparisonOperator: GreaterThanThreshold
      AlarmActions:
        # Uncomment and replace with your SNS Topic ARN to enable notifications:
        # - arn:aws:sns:ap-south-1:YOUR_ACCOUNT_ID:exam-system-alerts

  AWSEBCloudWatchAlarm5xxErrorRate:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: ExamSystem-5xxErrorRate
      MetricName: HTTPCode_Target_5XX_Count
      Namespace: AWS/ApplicationELB
      Statistic: Sum
      Period: 120
      EvaluationPeriods: 1
      Threshold: 10
      ComparisonOperator: GreaterThanThreshold
      AlarmActions:
        # Uncomment and replace with your SNS Topic ARN to enable notifications:
        # - arn:aws:sns:ap-south-1:YOUR_ACCOUNT_ID:exam-system-alerts
